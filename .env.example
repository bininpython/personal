NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Opcional: melhora o texto dos relatórios. Sem esta chave, o motor local gratuito continua funcionando.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Protege a tarefa diária que gera alertas automáticos no Vercel.
CRON_SECRET=

# Only required by maintenance scripts such as upload-videos.js.
DATABASE_URL=
EXERCISE_VIDEOS_PATH=
