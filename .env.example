NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site. Usado por metadataBase, sitemap e robots.
# Na Vercel, VERCEL_PROJECT_PRODUCTION_URL cobre isso automaticamente.
NEXT_PUBLIC_SITE_URL=

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# 32+ random characters. Signs the HttpOnly application session cookie.
SESSION_SECRET=

# Optional independent pepper used when hashing rate-limit identifiers.
RATE_LIMIT_SECRET=

# Protege a tarefa diária que gera alertas automáticos no Vercel.
CRON_SECRET=

# Only required by maintenance scripts such as upload-videos.js.
DATABASE_URL=
EXERCISE_VIDEOS_PATH=
